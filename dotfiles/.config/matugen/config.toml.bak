# #########################
# ### MATUGEN: CONFIG ###
# #########################
#
# Every template below rewrites an existing Aurora colors file in place, so the
# key names in each generated file stay identical to the hand written ones the
# rest of the rice already imports.
#
# Regenerate with:
#   matugen image ~/.config/hypr/default.png
#   matugen color hex '#cba6f7'
#
# waybar and swaync reload themselves through the post_hook below. kitty,
# rofi, btop, quickshell and wlogout read their colours once at startup, so
# restart those yourself (or add your own post_hook).

[config]
show_preview = false

# Aurora draws its wallpaper with awww. `set = false` keeps matugen from
# touching the wallpaper, because here the wallpaper is the *input*. Flip it to
# true if you drive matugen from a single colour instead of an image and want
# matugen to own the awww call.
[config.wallpaper]
command = "awww"
arguments = ["img", "--transition-type", "any"]
set = false

# ##########################
# ### MATUGEN: TEMPLATES ###
# ##########################

[templates.hypr]
input_path = "~/.config/matugen/templates/hypr-colors.lua.template"
output_path = "~/.config/hypr/colors.lua"

[templates.hypr-custom]
input_path = "~/.config/matugen/templates/hypr-custom.css.template"
output_path = "~/.config/hypr/scripts/src/custom.css"

[templates.quickshell]
input_path = "~/.config/matugen/templates/quickshell-colors.qml.template"
output_path = "~/.config/quickshell/colors.qml"

[templates.waybar]
input_path = "~/.config/matugen/templates/waybar-colors.css.template"
output_path = "~/.config/waybar/colors.css"
post_hook = "waybar_refresh"

[templates.wlogout]
input_path = "~/.config/matugen/templates/wlogout-colors.css.template"
output_path = "~/.config/wlogout/colors.css"

[templates.swaync]
input_path = "~/.config/matugen/templates/swaync-colors.css.template"
output_path = "~/.config/swaync/colors.css"
post_hook = "pkill -SIGUSR1 swaync"

[templates.rofi]
input_path = "~/.config/matugen/templates/rofi-colors.rasi.template"
output_path = "~/.config/rofi/colors.rasi"

[templates.kitty]
input_path = "~/.config/matugen/templates/kitty-colors.conf.template"
output_path = "~/.config/kitty/colors.conf"

[templates.ghostty]
input_path = "~/.config/matugen/templates/ghostty-colors.ghostty.template"
output_path = "~/.config/ghostty/colors.ghostty"

[templates.btop]
input_path = "~/.config/matugen/templates/btop-theme.template"
output_path = "~/.config/btop/themes/current.theme"
