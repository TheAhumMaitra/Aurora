# #######################
# ### MATUGEN: BTOP ###
# #######################

# Generated by matugen. Do not edit; edit the template in
# ~/.config/matugen/templates/btop-theme.template instead.

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="{{ base16.base00.dark.hex | to_color | set_lightness: 8 | format: "hex" }}"

# Main text color
theme[main_fg]="{{ base16.base05.dark.hex | to_color | set_lightness: 85 | format: "hex" }}"

# Title color for boxes
theme[title]="{{ base16.base05.dark.hex | to_color | set_lightness: 85 | format: "hex" }}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{ base16.base0d.dark.hex }}"

# Background color of selected item in processes box
theme[selected_bg]="{{ base16.base02.dark.hex | to_color | set_lightness: 14 | format: "hex" }}"

# Foreground color of selected item in processes box
theme[selected_fg]="{{ base16.base0d.dark.hex }}"

# Color of inactive/disabled text
theme[inactive_fg]="{{ base16.base04.dark.hex | to_color | set_lightness: 34 | format: "hex" }}"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="{{ base16.base0e.dark.hex }}"

# Background color of the percentage meters
theme[meter_bg]="{{ base16.base02.dark.hex | to_color | set_lightness: 14 | format: "hex" }}"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="{{ base16.base0e.dark.hex }}"

# CPU, Memory, Network, Proc box outline colors. base16 carries no fixed
# green/blue hue, so those boxes rotate the base0d accent to one.
theme[cpu_box]="{{ base16.base0d.dark.hex }}" #primary
theme[mem_box]="{{ base16.base0d.dark.hex | to_color | set_hue: 130 | set_saturation: 45.0 | set_lightness: 45 | format: "hex" }}" #green
theme[net_box]="{{ base16.base0e.dark.hex }}" #tertiary
theme[proc_box]="{{ base16.base0d.dark.hex | to_color | set_hue: 250 | set_saturation: 50.0 | set_lightness: 55 | format: "hex" }}" #blue

# Box divider line and small boxes line color
theme[div_line]="{{ base16.base03.dark.hex | to_color | set_lightness: 34 | format: "hex" }}"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="{{ base16.base0d.dark.hex | to_color | set_hue: 130 | set_saturation: 45.0 | set_lightness: 45 | format: "hex" }}"
theme[temp_mid]="{{ base16.base0d.dark.hex | to_color | set_hue: 45 | set_saturation: 60.0 | set_lightness: 60 | format: "hex" }}"
theme[temp_end]="{{ base16.base08.dark.hex }}"

# CPU graph colors (Teal -> Lavender)
theme[cpu_start]="{{ base16.base0a.dark.hex }}"
theme[cpu_mid]="{{ base16.base0d.dark.hex | to_color | set_hue: 250 | set_saturation: 50.0 | set_lightness: 55 | format: "hex" }}"
theme[cpu_end]="{{ base16.base0e.dark.hex }}"

# Mem/Disk free meter (primary -> blue)
theme[free_start]="{{ base16.base0d.dark.hex }}"
theme[free_mid]="{{ base16.base0d.dark.hex | to_color | set_hue: 250 | set_saturation: 50.0 | set_lightness: 55 | format: "hex" }}"
theme[free_end]="{{ base16.base0d.dark.hex | to_color | set_hue: 250 | set_saturation: 60.0 | set_lightness: 68 | format: "hex" }}"

# Mem/Disk cached meter (blue -> lavender)
theme[cached_start]="{{ base16.base0d.dark.hex | to_color | set_hue: 250 | set_saturation: 50.0 | set_lightness: 55 | format: "hex" }}"
theme[cached_mid]="{{ base16.base0e.dark.hex }}"
theme[cached_end]="{{ base16.base0d.dark.hex | lighten: 10.0 | format: "hex" }}"

# Mem/Disk available meter (tertiary -> Red)
theme[available_start]="{{ base16.base0e.dark.hex }}"
theme[available_mid]="{{ base16.base0e.dark.hex }}"
theme[available_end]="{{ base16.base08.dark.hex }}"

# Mem/Disk used meter (Green -> Teal)
theme[used_start]="{{ base16.base0d.dark.hex | to_color | set_hue: 130 | set_saturation: 45.0 | set_lightness: 45 | format: "hex" }}"
theme[used_mid]="{{ base16.base0a.dark.hex }}"
theme[used_end]="{{ base16.base0a.dark.hex | to_color | lighten: 8.0 | format: "hex" }}"

# Download graph colors (tertiary -> Red)
theme[download_start]="{{ base16.base0e.dark.hex }}"
theme[download_mid]="{{ base16.base0e.dark.hex }}"
theme[download_end]="{{ base16.base08.dark.hex }}"

# Upload graph colors (Green -> Teal)
theme[upload_start]="{{ base16.base0d.dark.hex | to_color | set_hue: 130 | set_saturation: 45.0 | set_lightness: 45 | format: "hex" }}"
theme[upload_mid]="{{ base16.base0a.dark.hex }}"
theme[upload_end]="{{ base16.base0a.dark.hex | to_color | lighten: 8.0 | format: "hex" }}"

# Process box color gradient for threads, mem and cpu usage (blue -> primary)
theme[process_start]="{{ base16.base0d.dark.hex | to_color | set_hue: 250 | set_saturation: 50.0 | set_lightness: 55 | format: "hex" }}"
theme[process_mid]="{{ base16.base0e.dark.hex }}"
theme[process_end]="{{ base16.base0d.dark.hex }}"