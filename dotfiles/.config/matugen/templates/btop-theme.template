# #######################
# ### MATUGEN: BTOP ###
# #######################

# Generated by matugen. Do not edit; edit the template in
# ~/.config/matugen/templates/btop-theme.template instead.

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="{{ colors.background.default.hex }}"

# Main text color
theme[main_fg]="{{ colors.on_surface.default.hex }}"

# Title color for boxes
theme[title]="{{ colors.on_surface.default.hex }}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{ colors.primary.default.hex }}"

# Background color of selected item in processes box
theme[selected_bg]="{{ colors.surface_container_high.default.hex }}"

# Foreground color of selected item in processes box
theme[selected_fg]="{{ colors.primary.default.hex }}"

# Color of inactive/disabled text
theme[inactive_fg]="{{ colors.outline.default.hex }}"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="{{ colors.tertiary.default.hex }}"

# Background color of the percentage meters
theme[meter_bg]="{{ colors.surface_container_high.default.hex }}"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="{{ colors.tertiary.default.hex }}"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="{{ colors.primary.default.hex }}" #primary
theme[mem_box]="{{ colors.primary.default.hex | to_color | set_hue: 130 | set_saturation: 45.0 | set_lightness: 45 | format: "hex" }}" #green
theme[net_box]="{{ colors.tertiary.default.hex }}" #tertiary
theme[proc_box]="{{ colors.primary.default.hex | to_color | set_hue: 250 | set_saturation: 50.0 | set_lightness: 55 | format: "hex" }}" #blue

# Box divider line and small boxes line color
theme[div_line]="{{ colors.outline_variant.default.hex }}"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="{{ colors.primary.default.hex | to_color | set_hue: 130 | set_saturation: 45.0 | set_lightness: 45 | format: "hex" }}"
theme[temp_mid]="{{ colors.primary.default.hex | to_color | set_hue: 45 | set_saturation: 60.0 | set_lightness: 60 | format: "hex" }}"
theme[temp_end]="{{ colors.error.default.hex }}"

# CPU graph colors (Teal -> Lavender)
theme[cpu_start]="{{ colors.secondary.default.hex }}"
theme[cpu_mid]="{{ colors.primary.default.hex | to_color | set_hue: 250 | set_saturation: 50.0 | set_lightness: 55 | format: "hex" }}"
theme[cpu_end]="{{ colors.tertiary.default.hex }}"

# Mem/Disk free meter (primary -> blue)
theme[free_start]="{{ colors.primary.default.hex }}"
theme[free_mid]="{{ colors.primary.default.hex | to_color | set_hue: 250 | set_saturation: 50.0 | set_lightness: 55 | format: "hex" }}"
theme[free_end]="{{ colors.primary.default.hex | to_color | set_hue: 250 | set_saturation: 60.0 | set_lightness: 68 | format: "hex" }}"

# Mem/Disk cached meter (blue -> lavender)
theme[cached_start]="{{ colors.primary.default.hex | to_color | set_hue: 250 | set_saturation: 50.0 | set_lightness: 55 | format: "hex" }}"
theme[cached_mid]="{{ colors.tertiary.default.hex }}"
theme[cached_end]="{{ colors.primary.default.hex | to_color | lighten: 10.0 | format: "hex" }}"

# Mem/Disk available meter (tertiary -> Red)
theme[available_start]="{{ colors.tertiary.default.hex }}"
theme[available_mid]="{{ colors.tertiary.default.hex }}"
theme[available_end]="{{ colors.error.default.hex }}"

# Mem/Disk used meter (Green -> Teal)
theme[used_start]="{{ colors.primary.default.hex | to_color | set_hue: 130 | set_saturation: 45.0 | set_lightness: 45 | format: "hex" }}"
theme[used_mid]="{{ colors.secondary.default.hex }}"
theme[used_end]="{{ colors.secondary.default.hex | to_color | lighten: 8.0 | format: "hex" }}"

# Download graph colors (tertiary -> Red)
theme[download_start]="{{ colors.tertiary.default.hex }}"
theme[download_mid]="{{ colors.tertiary.default.hex }}"
theme[download_end]="{{ colors.error.default.hex }}"

# Upload graph colors (Green -> Teal)
theme[upload_start]="{{ colors.primary.default.hex | to_color | set_hue: 130 | set_saturation: 45.0 | set_lightness: 45 | format: "hex" }}"
theme[upload_mid]="{{ colors.secondary.default.hex }}"
theme[upload_end]="{{ colors.secondary.default.hex | to_color | lighten: 8.0 | format: "hex" }}"

# Process box color gradient for threads, mem and cpu usage (blue -> primary)
theme[process_start]="{{ colors.primary.default.hex | to_color | set_hue: 250 | set_saturation: 50.0 | set_lightness: 55 | format: "hex" }}"
theme[process_mid]="{{ colors.tertiary.default.hex }}"
theme[process_end]="{{ colors.primary.default.hex }}"