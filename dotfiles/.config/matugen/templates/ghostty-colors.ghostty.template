# vim:ft=ghostty

## name:     Aurora (matugen)
## author:   Aurora <https://github.com/TheAhumMaitra/Aurora>
## license:  GPL-3.0-or-later
## blurb:    Material You colours generated by matugen from the current wallpaper

## #######################
## ### MATUGEN: GHOSTTY ###
## #######################

## Generated by matugen. Do not edit; edit the template in
## ~/.config/matugen/templates/ghostty-colors.ghostty.template instead.
##
## Loaded by ~/.config/ghostty/config.ghostty through
## `config-file = ./colors.ghostty`, which `aurora ghostty theme on` enables.

# The basic colors
background = {{ colors.background.default.hex }}
foreground = {{ colors.on_surface.default.hex }}

# Cursor colors
cursor-color = {{ colors.primary.default.hex }}
cursor-text = {{ colors.on_primary.default.hex }}

# Selection colors
selection-background = {{ colors.primary.default.hex }}
selection-foreground = {{ colors.on_primary.default.hex }}

# The 16 terminal colors

# black
palette = 0={{ colors.surface_container_high.default.hex }}
palette = 8={{ colors.outline_variant.default.hex }}

# red
palette = 1={{ colors.error.default.hex }}
palette = 9={{ colors.error.default.hex }}

# green
palette = 2={{ colors.primary.default.hex | to_color | set_hue: 130 | set_saturation: 45.0 | set_lightness: 45 | format: "hex" }}
palette = 10={{ colors.primary.default.hex | to_color | set_hue: 130 | set_saturation: 45.0 | set_lightness: 60 | format: "hex" }}

# yellow
palette = 3={{ colors.primary.default.hex | to_color | set_hue: 45 | set_saturation: 60.0 | set_lightness: 60 | format: "hex" }}
palette = 11={{ colors.primary.default.hex | to_color | set_hue: 45 | set_saturation: 70.0 | set_lightness: 70 | format: "hex" }}

# blue
palette = 4={{ colors.primary.default.hex | to_color | set_hue: 250 | set_saturation: 50.0 | set_lightness: 55 | format: "hex" }}
palette = 12={{ colors.primary.default.hex | to_color | set_hue: 250 | set_saturation: 60.0 | set_lightness: 68 | format: "hex" }}

# magenta
palette = 5={{ colors.tertiary.default.hex }}
palette = 13={{ colors.tertiary.default.hex | lighten: 8.0 | format: "hex" }}

# cyan
palette = 6={{ colors.secondary.default.hex }}
palette = 14={{ colors.secondary.default.hex | lighten: 8.0 | format: "hex" }}

# white
palette = 7={{ colors.on_surface_variant.default.hex }}
palette = 15={{ colors.on_surface.default.hex }}