# The basic colors
background = {{ base16.base00.dark.hex | to_color | set_lightness: 8 | format: "hex" }}
foreground = {{ base16.base05.dark.hex | to_color | set_lightness: 85 | format: "hex" }}

# Cursor colors
cursor-color = {{ base16.base0d.dark.hex }}
cursor-text = {{ base16.base06.dark.hex | to_color | set_lightness: 90 | format: "hex" }}

# Selection colors
selection-background = {{ base16.base0d.dark.hex }}
selection-foreground = {{ base16.base06.dark.hex | to_color | set_lightness: 90 | format: "hex" }}

# The 16 terminal colors. base16 has no fixed red/green/yellow/blue/magenta/cyan
# ramp, so the six mid slots rotate base0d to the hue the ANSI slot expects.

# black
