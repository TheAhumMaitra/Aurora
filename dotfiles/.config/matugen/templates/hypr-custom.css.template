/* Generated by matugen. Do not edit; edit the template in
   ~/.config/matugen/templates/hypr-custom.css.template instead. */

@define-color accent {{ colors.primary.default.hex }};
@define-color active-background {{ colors.surface_container_high.default.hex }};
@define-color active-accent {{ colors.tertiary.default.hex }};
@define-color urgent-background {{ colors.error.default.hex }};
@define-color border {{ colors.outline.default.hex }};
@define-color surface {{ colors.surface_container.default.hex }};
@define-color surface-alt {{ colors.surface_container_high.default.hex }};
@define-color muted {{ colors.outline_variant.default.hex }};
@define-color theme_bg_color {{ colors.surface.default.hex }};
@define-color theme_fg_color {{ colors.on_surface.default.hex }};

/* Material 3 has no success or warning role, so the source colour is rotated to
   a fixed green and red hue, then normalised to stay readable in both light and
   dark palettes. */
@define-color success_color {{ colors.source_color.default.hex | to_color | set_hue: 130 | set_saturation: 60.0 | set_lightness: 55 | format: "hex" }};
@define-color warning_color {{ colors.source_color.default.hex | to_color | set_hue: 0 | set_saturation: 75.0 | set_lightness: 60 | format: "hex" }};