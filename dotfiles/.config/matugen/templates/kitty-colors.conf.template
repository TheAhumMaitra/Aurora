## Generated by matugen. Do not edit; edit the template in
## ~/.config/matugen/templates/kitty-colors.conf.template instead.

# The basic colors
foreground              {{ colors.on_surface.default.hex }}
background              {{ colors.background.default.hex }}
selection_foreground    {{ colors.on_primary.default.hex }}
selection_background    {{ colors.primary.default.hex }}

# Cursor colors
cursor                  {{ colors.primary.default.hex }}
cursor_text_color       {{ colors.on_primary.default.hex }}

# Scrollbar colors
scrollbar_handle_color  {{ colors.outline.default.hex }}
scrollbar_track_color   {{ colors.surface_container_high.default.hex }}

# URL color when hovering with mouse
url_color               {{ colors.primary.default.hex }}

# Kitty window border colors
active_border_color     {{ colors.primary.default.hex }}
inactive_border_color   {{ colors.outline_variant.default.hex }}
bell_border_color       {{ colors.primary.default.hex | to_color | set_hue: 45 | set_saturation: 60.0 | set_lightness: 60 | format: "hex" }}

# OS Window titlebar colors
wayland_titlebar_color system
macos_titlebar_color system

# Tab bar colors
active_tab_foreground   {{ colors.on_primary.default.hex }}
active_tab_background   {{ colors.primary.default.hex }}
inactive_tab_foreground {{ colors.on_surface.default.hex }}
inactive_tab_background {{ colors.surface_container.default.hex }}
tab_bar_background      {{ colors.surface_container_lowest.default.hex }}

# Colors for marks (marked text in the terminal)
mark1_foreground {{ colors.on_secondary.default.hex }}
mark1_background {{ colors.secondary.default.hex }}
mark2_foreground {{ colors.on_primary.default.hex }}
mark2_background {{ colors.primary.default.hex }}
mark3_foreground {{ colors.on_tertiary.default.hex }}
mark3_background {{ colors.tertiary.default.hex }}

# The 16 terminal colors

# black
color0 {{ colors.surface_container_high.default.hex }}
color8 {{ colors.outline_variant.default.hex }}

# red
color1 {{ colors.error.default.hex }}
color9 {{ colors.error.default.hex }}

# green
color2 {{ colors.primary.default.hex | to_color | set_hue: 130 | set_saturation: 45.0 | set_lightness: 45 | format: "hex" }}
color10 {{ colors.primary.default.hex | to_color | set_hue: 130 | set_saturation: 45.0 | set_lightness: 60 | format: "hex" }}

# yellow
color3 {{ colors.primary.default.hex | to_color | set_hue: 45 | set_saturation: 60.0 | set_lightness: 60 | format: "hex" }}
color11 {{ colors.primary.default.hex | to_color | set_hue: 45 | set_saturation: 70.0 | set_lightness: 70 | format: "hex" }}

# blue
color4 {{ colors.primary.default.hex | to_color | set_hue: 250 | set_saturation: 50.0 | set_lightness: 55 | format: "hex" }}
color12 {{ colors.primary.default.hex | to_color | set_hue: 250 | set_saturation: 60.0 | set_lightness: 68 | format: "hex" }}

# magenta
color5 {{ colors.tertiary.default.hex }}
color13 {{ colors.tertiary.default.hex | to_color | lighten: 8.0 | format: "hex" }}

# cyan
color6 {{ colors.secondary.default.hex }}
color14 {{ colors.secondary.default.hex | to_color | lighten: 8.0 | format: "hex" }}

# white
color7 {{ colors.on_surface_variant.default.hex }}
color15 {{ colors.on_surface.default.hex }}