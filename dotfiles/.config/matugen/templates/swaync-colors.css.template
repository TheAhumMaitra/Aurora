/* Generated by matugen. Do not edit; edit the template in
   ~/.config/matugen/templates/swaync-colors.css.template instead. */

:root {
  --cc-bg: {{ colors.background.default.hex_alpha | to_color | set_alpha: 0.7 | format: "rgba" }};
  --noti-border-color: {{ colors.primary.default.hex_alpha | to_color | set_alpha: 0.15 | format: "rgba" }};
  --noti-bg: {{ colors.surface_container.default.red }}, {{ colors.surface_container.default.green }}, {{ colors.surface_container.default.blue }};
  --noti-bg-alpha: 0.8;
  --noti-bg-darker: {{ colors.background.default.rgb }};
  --noti-bg-hover: {{ colors.surface_container_high.default.rgb }};
  --noti-bg-focus: {{ colors.surface_container_highest.default.hex_alpha | to_color | set_alpha: 0.6 | format: "rgba" }};
  --noti-close-bg: {{ colors.surface_container_high.default.rgb }};
  --noti-close-bg-hover: {{ colors.outline_variant.default.rgb }};
  --text-color: {{ colors.on_surface.default.hex }};
  --text-color-disabled: {{ colors.outline_variant.default.hex }};
  --bg-selected: {{ colors.primary.default.hex }};
  --noti-bg-alt: {{ colors.surface_container_high.default.rgb }};
}

/* Fallback for older CSS themes */
@define-color cc-bg {{ colors.background.default.hex_alpha | to_color | set_alpha: 0.7 | format: "rgba" }};
@define-color noti-border-color {{ colors.primary.default.hex_alpha | to_color | set_alpha: 0.15 | format: "rgba" }};
@define-color noti-bg {{ colors.surface_container.default.hex_alpha | to_color | set_alpha: 0.8 | format: "rgba" }};
@define-color noti-bg-opaque {{ colors.surface_container.default.rgb }};
@define-color noti-bg-darker {{ colors.background.default.rgb }};
@define-color noti-bg-hover {{ colors.surface_container_high.default.rgb }};
@define-color noti-bg-hover-opaque {{ colors.surface_container_high.default.rgb }};
@define-color noti-bg-focus {{ colors.surface_container_highest.default.hex_alpha | to_color | set_alpha: 0.6 | format: "rgba" }};
@define-color noti-close-bg {{ colors.surface_container_high.default.hex_alpha | to_color | set_alpha: 0.9 | format: "rgba" }};
@define-color noti-close-bg-hover {{ colors.outline_variant.default.hex_alpha | to_color | set_alpha: 0.9 | format: "rgba" }};
@define-color text-color {{ colors.on_surface.default.hex }};
@define-color text-color-disabled {{ colors.outline_variant.default.hex }};
@define-color bg-selected {{ colors.primary.default.hex }};