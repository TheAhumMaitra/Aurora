{
  // Copy + merge this into your waybar config (typically ~/.config/waybar/config.jsonc).
  // Wire the toggle onto your existing volume module or a custom module:
  "pulseaudio": {
    // volume-at-max goes amber above 100%
    "format": "{icon} {volume}%",
    "format-muted": "\uf6a9 {volume}%",
    "on-click": "quickshell -c volume_adjuster ipc call volume toggle",
    "on-click-middle": "quickshell -c volume_adjuster ipc call volume toggleSinkMute"
  }
}