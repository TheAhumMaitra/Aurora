configuration {
    modes: "drun,run,window,emoji";
    show-icons: true;
    icon-theme: "Papirus";
    font: "JetBrainsMono Nerd Font 11";

    display-drun: "";
    display-run: "";
    display-window: "";
    display-emoji: "";

    drun-display-format: "{name}";
}

@theme "~/.config/rofi/colors.rasi"

* {
    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    width: 600px;
    height: 420px;

    border: 2px;
    border-color: @bordercolor;
    border-radius: 14px;

    background-color: @background;
    padding: 10px;
}

mainbox {
    spacing: 12px;
    background-color: transparent;
}

inputbar {
    children: [entry];
    background-color: @entry-background;
    border-radius: 10px;
    padding: 12px;
}

entry {
    background-color: transparent;
    text-color: @foreground;
    placeholder: "Search...";
}

message {
    background-color: transparent;
}

listview {
    columns: 1;
    lines: 10;
    spacing: 6px;
    scrollbar: false;
    background-color: transparent;
}

element {
    background-color: transparent;
    border-radius: 10px;
    padding: 10px;
}

element selected {
    background-color: @urgent-background;
}

element-icon {
    background-color: transparent;
    size: 30px;
    margin: 0px 10px 0px 0px;
}

element-text {
    background-color: transparent;
    text-color: @foreground;
    vertical-align: 0.5;
}

element-text selected {
    background-color: transparent;
    text-color: @foreground;
}

element-icon selected {
    background-color: transparent;
}

mode-switcher {
    enabled: false;
}
