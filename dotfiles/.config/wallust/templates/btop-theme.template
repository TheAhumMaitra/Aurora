# #####################
# ### WALLUST: BTOP ###
# #####################

# Generated by wallust. Do not edit; edit the template in
# ~/.config/wallust/templates/btop-theme.template instead.

# Main background, empty for terminal default, need to be empty if you want transparent background
theme[main_bg]="{{ background }}"

# Main text color
theme[main_fg]="{{ foreground | blend("#D8D8D8") }}"

# Title color for boxes
theme[title]="{{ foreground | blend("#D8D8D8") }}"

# Highlight color for keyboard shortcuts
theme[hi_fg]="{{ color6 }}"

# Background color of selected item in processes box
theme[selected_bg]="{{ background | lighten(0.11) }}"

# Foreground color of selected item in processes box
theme[selected_fg]="{{ color6 }}"

# Color of inactive/disabled text
theme[inactive_fg]="{{ foreground | blend("#5A5A5A") | blend("#5A5A5A") }}"

# Color of text appearing on top of graphs, i.e uptime and current network graph scaling
theme[graph_text]="{{ color5 }}"

# Background color of the percentage meters
theme[meter_bg]="{{ background | lighten(0.11) }}"

# Misc colors for processes box including mini cpu graphs, details memory graph and details status text
theme[proc_misc]="{{ color5 }}"

# CPU, Memory, Network, Proc box outline colors
theme[cpu_box]="{{ color6 }}" #cyan, primary
theme[mem_box]="{{ "#98C379" }}" #green
theme[net_box]="{{ color5 }}" #tertiary
theme[proc_box]="{{ "#61AFEF" }}" #blue

# Box divider line and small boxes line color
theme[div_line]="{{ background | lighten(0.22) }}"

# Temperature graph color (Green -> Yellow -> Red)
theme[temp_start]="{{ "#98C379" }}"
theme[temp_mid]="{{ "#E5C07B" }}"
theme[temp_end]="{{ "#E06C75" }}"

# CPU graph colors (Teal -> Lavender)
theme[cpu_start]="{{ color6 }}"
theme[cpu_mid]="{{ color5 }}"
theme[cpu_end]="{{ color4 }}"

# Mem/Disk free meter (primary -> blue)
theme[free_start]="{{ color6 }}"
theme[free_mid]="{{ "#61AFEF" }}"
theme[free_end]="{{ "#61AFEF" | lighten(0.18) }}"

# Mem/Disk cached meter (blue -> lavender)
theme[cached_start]="{{ "#61AFEF" }}"
theme[cached_mid]="{{ color5 }}"
theme[cached_end]="{{ color5 | lighten(0.18) }}"

# Mem/Disk available meter (tertiary -> Red)
theme[available_start]="{{ color5 }}"
theme[available_mid]="{{ color4 }}"
theme[available_end]="{{ "#E06C75" }}"

# Mem/Disk used meter (Green -> Teal)
theme[used_start]="{{ "#98C379" }}"
theme[used_mid]="{{ color6 }}"
theme[used_end]="{{ color6 | lighten(0.18) }}"

# Download graph colors (tertiary -> Red)
theme[download_start]="{{ color5 }}"
theme[download_mid]="{{ color4 }}"
theme[download_end]="{{ "#E06C75" }}"

# Upload graph colors (Green -> Teal)
theme[upload_start]="{{ "#98C379" }}"
theme[upload_mid]="{{ color6 }}"
theme[upload_end]="{{ color6 | lighten(0.18) }}"

# Process box color gradient for threads, mem and cpu usage (blue -> primary)
theme[process_start]="{{ "#61AFEF" }}"
theme[process_mid]="{{ color5 }}"
theme[process_end]="{{ color6 }}"
