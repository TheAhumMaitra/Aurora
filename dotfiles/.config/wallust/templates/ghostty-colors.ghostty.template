## ######################
## ### WALLUST: GHOSTTY ###
## ######################

## Generated by wallust. Do not edit; edit the template in
## ~/.config/wallust/templates/ghostty-colors.ghostty.template instead.
##
## Loaded by ~/.config/ghostty/config.ghostty through
## `config-file = ./colors.ghostty`, which `aurora ghostty theme on` enables.

# The basic colors
background = {{ background }}
foreground = {{ foreground | blend("#D8D8D8") }}

# Cursor colors
cursor-color = {{ color6 }}
cursor-text = {{ color15 }}

# Selection colors
selection-background = {{ color6 }}
selection-foreground = {{ color7 | blend("#FFFFFF") | blend("#FFFFFF") }}

# The 16 terminal colors

# black
palette = 0={{ background | lighten(0.12) }}
palette = 8={{ background | lighten(0.24) }}

# red
palette = 1={{ "#E06C75" }}
palette = 9={{ "#E06C75" | lighten(0.18) }}

# green
palette = 2={{ "#98C379" }}
palette = 10={{ "#98C379" | lighten(0.18) }}

# yellow
palette = 3={{ "#E5C07B" }}
palette = 11={{ "#E5C07B" | lighten(0.18) }}

# blue
palette = 4={{ "#61AFEF" }}
palette = 12={{ "#61AFEF" | lighten(0.18) }}

# magenta
palette = 5={{ "#C678DD" }}
palette = 13={{ "#C678DD" | lighten(0.18) }}

# cyan
palette = 6={{ "#56B6C2" }}
palette = 14={{ "#56B6C2" | lighten(0.18) }}

# white
palette = 7={{ foreground | blend("#D8D8D8") }}
palette = 15={{ color15 }}
