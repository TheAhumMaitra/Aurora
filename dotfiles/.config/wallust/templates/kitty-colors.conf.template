## Generated by wallust. Do not edit; edit the template in
## ~/.config/wallust/templates/kitty-colors.conf.template instead.

# The basic colors
foreground              {{ foreground | blend("#D8D8D8") }}
background              {{ background }}
selection_foreground    {{ color7 | blend("#FFFFFF") | blend("#FFFFFF") }}
selection_background    {{ color6 }}

# Cursor colors
cursor                  {{ color6 }}
cursor_text_color       {{ color15 }}

# Scrollbar colors
scrollbar_handle_color  {{ background | lighten(0.24) }}
scrollbar_track_color   {{ background | lighten(0.11) }}

# URL color when hovering with mouse
url_color               {{ color6 }}

# Kitty window border colors
active_border_color     {{ color6 }}
inactive_border_color   {{ background | lighten(0.22) }}
bell_border_color       {{ "#E5C07B" }}

# OS Window titlebar colors
wayland_titlebar_color system
macos_titlebar_color system

# Tab bar colors
active_tab_foreground   {{ color7 | blend("#FFFFFF") | blend("#FFFFFF") }}
active_tab_background   {{ color6 }}
inactive_tab_foreground {{ foreground | blend("#D8D8D8") }}
inactive_tab_background {{ background | lighten(0.05) }}
tab_bar_background      {{ background | lighten(0.11) }}

# Colors for marks (marked text in the terminal)
mark1_foreground {{ color7 | blend("#FFFFFF") | blend("#FFFFFF") }}
mark1_background {{ color6 }}
mark2_foreground {{ color7 | blend("#FFFFFF") | blend("#FFFFFF") }}
mark2_background {{ color5 }}
mark3_foreground {{ color7 | blend("#FFFFFF") | blend("#FFFFFF") }}
mark3_background {{ color4 }}

# The 16 terminal colors

# black
color0 {{ background | lighten(0.12) }}
color8 {{ background | lighten(0.24) }}

# red
color1 {{ "#E06C75" }}
color9 {{ "#E06C75" | lighten(0.18) }}

# green
color2 {{ "#98C379" }}
color10 {{ "#98C379" | lighten(0.18) }}

# yellow
color3 {{ "#E5C07B" }}
color11 {{ "#E5C07B" | lighten(0.18) }}

# blue
color4 {{ "#61AFEF" }}
color12 {{ "#61AFEF" | lighten(0.18) }}

# magenta
color5 {{ "#C678DD" }}
color13 {{ "#C678DD" | lighten(0.18) }}

# cyan
color6 {{ "#56B6C2" }}
color14 {{ "#56B6C2" | lighten(0.18) }}

# white
color7 {{ foreground | blend("#D8D8D8") }}
color15 {{ color15 }}
