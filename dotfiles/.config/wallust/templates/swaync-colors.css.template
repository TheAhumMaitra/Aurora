/* ### WALLUST: SWAYNC ### */
/* ####################### */

/* Generated by wallust. Do not edit; edit the template in
   ~/.config/wallust/templates/swaync-colors.css.template instead. */

:root {
  --cc-bg: rgba({{ background | rgb }}, 0.7);
  --noti-border-color: rgba({{ color6 | rgb }}, 0.15);
  --noti-bg: {{ background | lighten(0.05) | rgb }};
  --noti-bg-alpha: 0.8;
  --noti-bg-darker: rgb({{ background | rgb }});
  --noti-bg-hover: rgb({{ background | lighten(0.11) | rgb }});
  --noti-bg-focus: rgba({{ background | lighten(0.11) | rgb }}, 0.6);
  --noti-close-bg: rgb({{ background | lighten(0.11) | rgb }});
  --noti-close-bg-hover: rgb({{ background | lighten(0.22) | rgb }});
  --text-color: {{ foreground | blend("#D8D8D8") }};
  --text-color-disabled: {{ foreground | blend("#5A5A5A") | blend("#5A5A5A") }};
  --bg-selected: {{ color6 }};
  --noti-bg-alt: rgb({{ background | lighten(0.11) | rgb }});
}

/* Fallback for older CSS themes */
@define-color cc-bg rgba({{ background | rgb }}, 0.7);
@define-color noti-border-color rgba({{ color6 | rgb }}, 0.15);
@define-color noti-bg rgba({{ background | lighten(0.05) | rgb }}, 0.8);
@define-color noti-bg-opaque rgb({{ background | lighten(0.05) | rgb }});
@define-color noti-bg-darker rgb({{ background | rgb }});
@define-color noti-bg-hover rgb({{ background | lighten(0.11) | rgb }});
@define-color noti-bg-hover-opaque rgb({{ background | lighten(0.11) | rgb }});
@define-color noti-bg-focus rgba({{ background | lighten(0.11) | rgb }}, 0.6);
@define-color noti-close-bg rgba({{ background | lighten(0.11) | rgb }}, 0.9);
@define-color noti-close-bg-hover rgba({{ background | lighten(0.22) | rgb }}, 0.9);
@define-color text-color {{ foreground | blend("#D8D8D8") }};
@define-color text-color-disabled {{ foreground | blend("#5A5A5A") | blend("#5A5A5A") }};
@define-color bg-selected {{ color6 }};
