@define-color background {{ background }};
@define-color foreground {{ foreground | blend("#D8D8D8") }};
@define-color accent {{ color6 }};
@define-color active-background {{ background | lighten(0.11) }};
@define-color active-accent {{ color5 }};
@define-color urgent-background {{ "#E06C75" }};
@define-color border {{ background | lighten(0.22) }};
