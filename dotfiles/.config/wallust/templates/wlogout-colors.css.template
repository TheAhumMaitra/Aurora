/* Generated by wallust. Do not edit; edit the template in
   ~/.config/wallust/templates/wlogout-colors.css.template instead. */

@define-color background rgba({{ background | rgb }}, 0.2);
@define-color border-color {{ color6 }};
@define-color foreground  {{ foreground | blend("#D8D8D8") }};
@define-color button-background  rgba({{ background | lighten(0.05) | rgb }}, 0.2);
@define-color active-background rgb({{ background | lighten(0.11) | rgb }});
